SCOS_MCP_GATEWAY_HTTP_ADDR=:8098
SCOS_HERMES_PROVIDER_URL=https://127.0.0.1:8088
SCOS_MEMORY_INTELLIGENCE_URL=https://127.0.0.1:8089
# Overrides the shared internal dev cert from scos-fabric.env: this is the one
# service reached by external MCP clients that verify against the public CA
# pool (Claude Code --transport http, Claude Desktop Connectors), so it needs
# a real cert, not the internal self-signed one. See
# deploy/native/renew-mcp-gateway-cert.sh. SCOS_TLS_CA_FILE is deliberately
# NOT overridden here -- its outbound calls to hermes-provider and
# memory-intelligence still use the internal CA.
SCOS_TLS_CERT_FILE=/etc/scos/tls-external/tls.crt
SCOS_TLS_KEY_FILE=/etc/scos/tls-external/tls.key
