# Shared base environment for every native scos-fabric systemd unit.
# Copy to /etc/scos/scos-fabric.env (0640, owned by root:scos) and fill in
# the required values. This is loaded by every scos-fabric@.service instance
# via EnvironmentFile=; per-service overrides live in
# /etc/scos/env/<service>.env and load second, so they win on conflict.
#
# Never commit a filled-in copy of this file.

# ── required, no defaults (systemd refuses to start units with an empty
#    EnvironmentFile value the code checks for -- see docs/security-configuration.md) ──
SCOS_INTERNAL_SERVICE_TOKEN=
SCOS_CONTROL_PLANE_TOKEN=
SCOS_SECURITY_ISSUER_SECRET=
SCOS_AGENT_ENDPOINT=

# credential-vault's at-rest encryption key: base64-encoded, must decode to
# exactly 32 bytes (AES-256-GCM). Generate with:
#   openssl rand -base64 32
SCOS_CREDENTIAL_VAULT_MASTER_KEY=
# Key rotation: every stored value records the key_version it was sealed
# under. To rotate, move the current key into SCOS_CREDENTIAL_VAULT_PREVIOUS_KEYS
# as <version>:<base64 key> (comma-separated for several), set a new
# SCOS_CREDENTIAL_VAULT_MASTER_KEY with a higher SCOS_CREDENTIAL_VAULT_KEY_VERSION,
# restart credential-vault, then call POST /v1/admin/keys/rotate (claims scope
# credentials:admin) for each tenant. GET /v1/admin/keys reports what is still
# sealed under an old version; drop a previous key only once nothing is.
SCOS_CREDENTIAL_VAULT_KEY_VERSION=1
SCOS_CREDENTIAL_VAULT_PREVIOUS_KEYS=

# SCOS_DATABASE_URL / DATABASE_URL: native Postgres, so this points at
# 127.0.0.1 rather than a Compose service hostname. sslmode=require or
# stronger is enforced by packages/database.RequireTLS -- see
# deploy/native/postgres-setup.sh for the matching server-side TLS setup.
# Password must match the role postgres-setup.sh creates.
SCOS_DATABASE_URL=postgresql://scos:CHANGE_ME@127.0.0.1:5432/scos_memory?sslmode=require
DATABASE_URL=postgresql://scos:CHANGE_ME@127.0.0.1:5432/scos_memory?sslmode=require

SCOS_VERSION=0.1.0-dev
SCOS_SERVICE_IDENTITY=scos-service

# ── TLS: one shared self-signed dev CA, generated by deploy/native/install.sh
#    for SAN=localhost,127.0.0.1 -- every service on this host reaches every
#    other service over 127.0.0.1, so per-service DNS SANs (needed in the
#    Compose network) are not needed here. Replace with a real CA for a
#    deployment reachable by anything other than this host. ──
SCOS_TLS_REQUIRED=true
SCOS_TLS_CERT_FILE=/etc/scos/tls/tls.crt
SCOS_TLS_KEY_FILE=/etc/scos/tls/tls.key
SCOS_TLS_CA_FILE=/etc/scos/tls/tls.crt

# ── runtime budget: same defaults as deploy/compose/docker-compose.yml's
#    x-service-runtime-environment. See that file's comment for the sizing
#    rationale (4-core / small-RAM host budget) -- it applies identically
#    to a native deployment on the same class of host. ──
GOMAXPROCS=2
GOGC=50
GOMEMLIMIT=96MiB
SCOS_DB_MAX_CONNS=3
SCOS_DB_MAX_IDLE_CONNS=1

SCOS_LOG_LEVEL=info
SCOS_OBSERVABILITY_URL=https://127.0.0.1:8096

# Optional: leave unset for a fully offline deployment. See .env.example for
# what each of these gates.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
SCOS_SECRET_MANAGER=
SCOS_SECURESTORE_URL=
SCOS_SECURESTORE_AGENT_API_KEY=
SCOS_SECURESTORE_WORKSPACE_ID=
