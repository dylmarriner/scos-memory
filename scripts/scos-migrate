#!/bin/sh
set -eu

# P0-0: database/policies/000011_app_role.sql provisions the restricted
# scos_app role every service connects as at runtime, and needs a password
# supplied at apply time -- required, not defaulted, so a forgotten
# SCOS_APP_PASSWORD fails loudly here rather than silently creating (or
# leaving unchanged) a role with a guessable/empty password.
app_password=${SCOS_APP_PASSWORD:?SCOS_APP_PASSWORD must be provided (used by database/policies/000011_app_role.sql to provision the scos_app runtime role)}
# database/policies/000015_worker_role.sql provisions scos_worker, the role the
# background workers connect as; same required-not-defaulted contract.
worker_password=${SCOS_WORKER_PASSWORD:?SCOS_WORKER_PASSWORD must be provided (used by database/policies/000015_worker_role.sql to provision the scos_worker background-worker role)}
# database/policies/000016_backup_role.sql provisions scos_backup, the
# read-only role backup-manager dumps the database as.
backup_password=${SCOS_BACKUP_PASSWORD:?SCOS_BACKUP_PASSWORD must be provided (used by database/policies/000016_backup_role.sql to provision the scos_backup read-only backup role)}

database_url=${SCOS_DATABASE_URL:-}
if [ -n "$database_url" ]; then
  psql_cmd() { psql "$database_url" -v ON_ERROR_STOP=1 -v app_password="$app_password" -v worker_password="$worker_password" -v backup_password="$backup_password" "$@"; }
else
  psql_cmd() { psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -v app_password="$app_password" -v worker_password="$worker_password" -v backup_password="$backup_password" "$@"; }
fi
psql_cmd <<'SQL'
CREATE TABLE IF NOT EXISTS scos_schema_migrations (
    version text PRIMARY KEY,
    applied_at timestamptz NOT NULL DEFAULT now()
);
SQL

# An untracked non-empty database needs an operator-supplied inventory because
# the old init-only bootstrap did not record which files had run.
count=$(psql_cmd -Atqc "SELECT count(*) FROM scos_schema_migrations")
if [ "$count" = 0 ]; then
  has_schema=$(psql_cmd -Atqc "SELECT EXISTS (SELECT 1 FROM pg_class WHERE relkind IN ('r','p') AND relname = 'tenants')")
  if [ "$has_schema" = "t" ]; then
    baseline=${SCOS_MIGRATIONS_BASELINE:-}
    [ -n "$baseline" ] || {
      echo "SCOS_MIGRATIONS_BASELINE is required for an existing untracked database" >&2
      exit 1
    }
    old_ifs=$IFS
    IFS=,
    for version in $baseline; do
      version=$(printf '%s' "$version" | tr -d '[:space:]')
      [ -n "$version" ] || continue
      psql_cmd -c "INSERT INTO scos_schema_migrations(version) VALUES ('$version') ON CONFLICT DO NOTHING"
    done
    IFS=$old_ifs
  fi
fi

for file in /scos-database/migrations/*.sql /scos-database/policies/*.sql; do
  version=$(basename "$file" .sql)
  applied=$(psql_cmd -Atqc "SELECT EXISTS (SELECT 1 FROM scos_schema_migrations WHERE version = '$version')")
  if [ "$applied" = "f" ]; then
    psql_cmd -f "$file"
    psql_cmd -c "INSERT INTO scos_schema_migrations(version) VALUES ('$version')"
  fi
done

# Tables created by migrations applied after 000016 need the backup role's
# SELECT grant and read policy too; reconcile on every run.
psql_cmd -c "SELECT scos_reconcile_backup_role()"
