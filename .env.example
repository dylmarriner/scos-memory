SCOS_HTTP_ADDR=:8080
SCOS_VERSION=0.1.0-dev

# The tailnet interface every service's port is published on (docker
# compose `ports:`, not `expose:` -- deliberately bound to this one address
# rather than 0.0.0.0, so nothing here is reachable from the LAN or public
# internet, only from other devices on the same tailnet). Get this host's
# address with `tailscale ip -4`.
SCOS_TAILSCALE_IP=100.64.0.1

# Required by Compose. Inject high-entropy values through the deployment secret
# manager; these entries intentionally have no defaults.
SCOS_INTERNAL_SERVICE_TOKEN=
SCOS_CONTROL_PLANE_TOKEN=
SCOS_SECURITY_ISSUER_SECRET=
POSTGRES_PASSWORD=
SCOS_DATABASE_URL=

# P0-0: the restricted, NOSUPERUSER NOBYPASSRLS role every service connects
# as at runtime (distinct from POSTGRES_USER/SCOS_DATABASE_URL, which stays
# the migration-owning admin connection). SCOS_APP_PASSWORD provisions the
# role (database/policies/000011_app_role.sql); SCOS_APP_DATABASE_URL is the
# full connection string services actually use -- same host/port/database
# as SCOS_DATABASE_URL, scos_app credentials instead of the owner's.
SCOS_APP_PASSWORD=
SCOS_APP_DATABASE_URL=
SCOS_AGENT_ENDPOINT=

# credential-vault's at-rest encryption key for stored key/password values:
# base64-encoded, must decode to exactly 32 bytes (AES-256-GCM).
# Generate with: openssl rand -base64 32
SCOS_CREDENTIAL_VAULT_MASTER_KEY=

# Passphrase required to unlock editing (fact correct/forget) in the
# transparency dashboard. Leave unset to keep the dashboard view-only.
SCOS_DASHBOARD_EDIT_PASSPHRASE=

# Non-secret local development settings.
POSTGRES_USER=scos
POSTGRES_DB=scos_memory
SCOS_OBSERVABILITY_STORE_PATH=/var/lib/scos/observability/observability.jsonl

# Vector-memory embedding worker (local ONNX via fastembed, no API key).
SCOS_EMBED_MODEL=BAAI/bge-small-en-v1.5
SCOS_EMBEDDINGS_URL=http://embeddings-worker:8102
SCOS_EMBEDDINGS_HTTP_ADDR=:8102
SCOS_EMBEDDINGS_POLL_SECONDS=5
SCOS_EMBEDDINGS_BATCH_SIZE=64

# Scheduled worker cadences (seconds).
SCOS_INDEX_MAINTENANCE_INTERVAL=3600
SCOS_POLICY_EVAL_INTERVAL=21600

# Optional OTLP/HTTP JSON collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=scos-observability

SCOS_SECRET_MANAGER=

# Optional Securestore integration for security-gate's `securestore`
# secret-reference provider. Leave unset to keep the resolve endpoint
# disabled (it fails closed with 503 rather than silently no-oping).
SCOS_SECURESTORE_URL=
SCOS_SECURESTORE_AGENT_API_KEY=
SCOS_SECURESTORE_WORKSPACE_ID=
SCOS_BACKUP_PROVIDER=disabled
SCOS_BACKUP_PROVIDER_VERIFIED=false
SCOS_BACKUP_OFF_HOST_VERIFIED=false
SCOS_BACKUP_DESTINATION=
SCOS_BACKUP_ENCRYPTION_KEY_REF=
SCOS_WAL_ARCHIVE_DESTINATION=
SCOS_WAL_ARCHIVE_ENABLED=false
SCOS_PITR_ENABLED=false
SCOS_OKF_GIT_MIRROR_REMOTE=
SCOS_OKF_GIT_MIRROR_VERIFIED=false
SCOS_LOG_LEVEL=info

# Optional: real LLM reasoning (DeepSeek, OpenAI-compatible API) for
# memory-intelligence's entity extraction (scos_recall linking) and memory
# summarization (scos_memory_summary), and consolidation-worker's
# candidate title/content rewriting. Every call site falls back to a
# deterministic path when this is unset -- nothing in this fleet requires
# it to start or to serve its other endpoints.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash

# §16/§26 automatic OKF promotion: a fact whose authority/confidence clear
# these thresholds is offered to the LLM as an OKF proposal candidate (see
# memory-intelligence's maybePromoteToOKF). No-op without DEEPSEEK_API_KEY
# above -- the model is the actual durability judge, this is only a
# pre-filter. Proposals still require independent human review to merge.
SCOS_OKF_SYNCHRONISER_URL=
SCOS_OKF_PROMOTION_AUTHORITY_THRESHOLD=90
SCOS_OKF_PROMOTION_CONFIDENCE_THRESHOLD=0.85

# Dream-style Synthesis (§16/§25, mem0's Dream): consolidation-worker
# periodically distills a namespace's accumulated facts into higher-order
# pattern facts. No-op without DEEPSEEK_API_KEY above -- there is no
# deterministic fallback for pattern distillation.
SCOS_SYNTHESIS_MIN_FACTS=20
SCOS_SYNTHESIS_CADENCE_HOURS=24
SCOS_SYNTHESIS_MAX_FACTS=200
SCOS_SYNTHESIS_CHECK_INTERVAL_SECONDS=3600

# ── graphify knowledge-graph provider ────────────────────────────────────
# The directory graphify may read. Required: Compose fails closed rather
# than defaulting, because this mount is the full extent of what a caller
# can ask the graph about. Name the folder holding the repositories you
# want graphable -- never a whole drive or a home directory.
GRAPHIFY_WORKSPACE_HOST_PATH=
# The container-side bound for caller-supplied repo_path values. Must match
# the mount point above; an unset value makes the provider refuse any
# caller-supplied path rather than accepting an unbounded one.
GRAPHIFY_ALLOWED_ROOT=/workspaces
GRAPHIFY_CACHE_DIR=/var/lib/graphify-cache
# graphify runs as a subprocess and retains the AST for the whole repository;
# raise this for large repositories if extraction exceeds the default limit.
GRAPHIFY_SERVICE_MEM_LIMIT=1536m
SCOS_CLOUD_HTTP_ADDR=:8079
# Internal URL used by the transparency dashboard's same-origin /api proxy.
SCOS_CLOUD_CONTROL_PLANE_URL=https://cloud-control-plane:8079
# Host interface for the cloud console publication. Keep loopback unless an
# authenticated reverse proxy/Tailscale ingress is deliberately configured.
SCOS_CLOUD_BIND_ADDRESS=127.0.0.1
SCOS_CLOUD_PORT=8079
SCOS_MCP_GATEWAY_URL=https://mcp-gateway:8098
# cloud-control-plane's POST /api/cli/exchange returns this to a user's own
# machine, so unlike SCOS_MCP_GATEWAY_URL above it must be reachable from
# outside the docker network, not the internal service name.
SCOS_PUBLIC_GATEWAY_URL=
