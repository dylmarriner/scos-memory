SCOS_HTTP_ADDR=:8080
SCOS_VERSION=0.1.0-dev
DATABASE_URL=postgres://scos:replace-with-a-random-password@postgres:5432/scos_memory?sslmode=disable
POSTGRES_DB=scos_memory
POSTGRES_USER=scos
POSTGRES_PASSWORD=replace-with-a-random-password
SCOS_AUTH_ISSUER_SECRET=replace-with-a-long-random-service-secret
SCOS_EXTENSION_SIGNING_SECRET=replace-with-a-long-random-extension-secret
SCOS_LOG_LEVEL=info
