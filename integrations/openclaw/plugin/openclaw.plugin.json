{
  "id": "scos-memory",
  "name": "SCOS Memory Fabric",
  "description": "First-class OpenClaw persistent memory backed by the authoritative SCOS Memory Fabric.",
  "version": "2.0.0",
  "categories": ["memory", "tools"],
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "scos_recall",
      "scos_remember",
      "scos_explain",
      "scos_forget",
      "scos_status",
      "scos_memory_guidance"
    ]
  },
  "toolMetadata": {
    "scos_remember": { "sideEffecting": true },
    "scos_forget": { "sideEffecting": true }
  },
  "uiHints": {
    "gatewayUrl": {
      "label": "SCOS MCP Gateway URL",
      "placeholder": "https://127.0.0.1:8098/mcp"
    },
    "providerUrl": {
      "label": "SCOS Memory Lifecycle URL",
      "placeholder": "https://127.0.0.1:8088"
    },
    "token": {
      "label": "SCOS Bearer Token",
      "sensitive": true
    },
    "tenantId": { "label": "SCOS Tenant ID" },
    "principalId": { "label": "SCOS Principal ID" },
    "namespaceId": { "label": "SCOS Namespace ID" },
    "autoRecall": {
      "label": "Automatic Recall",
      "help": "Recall relevant SCOS memory before prompt construction"
    },
    "autoCapture": {
      "label": "Automatic Turn Persistence",
      "help": "Persist the last completed user/assistant exchange after successful agent turns"
    },
    "recallLimit": { "label": "Recall Result Limit", "advanced": true },
    "recallMaxChars": { "label": "Recall Context Character Limit", "advanced": true },
    "requestTimeoutMs": { "label": "SCOS Request Timeout (ms)", "advanced": true }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gatewayUrl": { "type": "string", "minLength": 1 },
      "providerUrl": { "type": "string", "minLength": 1 },
      "token": { "type": "string", "minLength": 1 },
      "tenantId": { "type": "string", "minLength": 1 },
      "principalId": { "type": "string", "minLength": 1 },
      "namespaceId": { "type": "string", "minLength": 1 },
      "autoRecall": { "type": "boolean" },
      "autoCapture": { "type": "boolean" },
      "recallLimit": { "type": "integer", "minimum": 1, "maximum": 20 },
      "recallMaxChars": { "type": "integer", "minimum": 256, "maximum": 12000 },
      "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
      "publicArtifactsDir": { "type": "string" }
    }
  }
}
