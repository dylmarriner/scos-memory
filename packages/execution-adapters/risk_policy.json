{
  "description": "Shared shell-command risk policy (GOVERNANCE.md \u00a720.3). Loaded by packages/execution-adapters (Go, embedded) and scos_execution (Python). A command is destructive if it starts with a destructive prefix, or if it is composed (contains ; | & newline ` $( or )) and contains any destructive token; otherwise write or test by prefix; otherwise read.",
  "composition_characters": ";|&\n`)$(",
  "destructive_prefixes": [
    "rm ",
    "rmdir ",
    "dd ",
    "mkfs",
    "format",
    "fdisk",
    "drop ",
    "truncate",
    "> /dev/",
    "chmod 0",
    "chown ",
    ":(){ :|:&};:",
    "mv ",
    "sudo ",
    "su ",
    "passwd",
    "useradd",
    "usermod",
    "groupadd",
    "shutdown",
    "reboot",
    "poweroff",
    "init ",
    "systemctl ",
    "service ",
    "iptables",
    "ufw ",
    "tcpdump",
    "nmap",
    "git push",
    "git merge",
    "git rebase",
    "git reset",
    "git commit",
    "pip install",
    "npm install -g",
    "apt install",
    "yum install",
    "brew install",
    "docker rm",
    "docker rmi",
    "docker stop",
    "docker kill",
    "kubectl delete",
    "kubectl apply",
    "helm install",
    "helm delete",
    "mysql ",
    "psql ",
    "post ",
    "put ",
    "delete ",
    "patch "
  ],
  "write_prefixes": [
    "touch ",
    "mkdir ",
    "cp ",
    "ln ",
    ">",
    ">>",
    "echo ",
    "printf ",
    "write",
    "tee",
    "sed -i",
    "awk",
    "git add",
    "git checkout",
    "git branch",
    "git tag",
    "npm install",
    "npm run",
    "yarn ",
    "npx ",
    "docker build",
    "docker compose",
    "docker-compose",
    "make ",
    "go build",
    "go install",
    "cargo build",
    "terraform ",
    "ansible-",
    "pulumi",
    "ssh ",
    "scp ",
    "rsync"
  ],
  "test_prefixes": [
    "go test",
    "python -m pytest",
    "npm test",
    "yarn test",
    "cargo test",
    "jest",
    "pytest",
    "rspec",
    "mocha"
  ]
}
