{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scos.local/memory/memory-candidate.schema.json",
  "title": "SCOS Memory Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "tenant_id",
    "namespace_id",
    "source_event_id",
    "memory_class",
    "title",
    "content",
    "authority_level",
    "confidence_score",
    "sensitivity_class",
    "evidence"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "namespace_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "memory_class": {
      "enum": [
        "discard",
        "journal_only",
        "working",
        "episodic",
        "semantic",
        "procedural",
        "governing",
        "artifact_reference",
        "revocation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "authority_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity_class": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference_id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
