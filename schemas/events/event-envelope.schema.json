{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scos.local/events/event-envelope.schema.json",
  "title": "SCOS Event Envelope",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "dataschema",
    "tenantid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^scos\\.[a-z0-9_.-]+\\.v[0-9]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "minLength": 1
    },
    "tenantid": {
      "type": "string",
      "format": "uuid"
    },
    "correlationid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causationid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actorid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
